{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["format","formatVersion","schemaVersion","applicationVersion","createdAt","dateRange","datasets"],
  "properties": {
    "format": {"const":"matkahelpotin-travel-export"},
    "formatVersion": {"type":"integer","const":1},
    "schemaVersion": {"type":"integer","const":1},
    "applicationVersion": {"type":"string"},
    "createdAt": {"type":"string","format":"date-time"},
    "dateRange": {"$ref":"#/$defs/dateRange"},
    "datasets": {"type":"array","items":{"enum":["commute","business-trips"]},"minItems":1,"uniqueItems":true}
  },
  "$defs":{"dateRange":{"type":"object","required":["from","until"],"properties":{"from":{"type":"string","format":"date"},"until":{"type":"string","format":"date"}},"additionalProperties":false}}
}
